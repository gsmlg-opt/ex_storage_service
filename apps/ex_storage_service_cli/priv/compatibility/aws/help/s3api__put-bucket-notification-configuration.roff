  \(dqQueueConfigurations\(dq: [
    {
      \(dqId\(dq: \(dqstring\(dq,
      \(dqQueueArn\(dq: \(dqstring\(dq,
      \(dqEvents\(dq: [\(dqs3:ReducedRedundancyLostObject\(dq|\(dqs3:ObjectCreated:*\(dq|\(dqs3:ObjectCreated:Put\(dq|\(dqs3:ObjectCreated:Post\(dq|\(dqs3:ObjectCreated:Copy\(dq|\(dqs3:ObjectCreated:CompleteMultipartUpload\(dq|\(dqs3:ObjectRemoved:*\(dq|\(dqs3:ObjectRemoved:Delete\(dq|\(dqs3:ObjectRemoved:DeleteMarkerCreated\(dq|\(dqs3:ObjectRestore:*\(dq|\(dqs3:ObjectRestore:Post\(dq|\(dqs3:ObjectRestore:Completed\(dq|\(dqs3:Replication:*\(dq|\(dqs3:Replication:OperationFailedReplication\(dq|\(dqs3:Replication:OperationNotTracked\(dq|\(dqs3:Replication:OperationMissedThreshold\(dq|\(dqs3:Replication:OperationReplicatedAfterThreshold\(dq|\(dqs3:ObjectRestore:Delete\(dq|\(dqs3:LifecycleTransition\(dq|\(dqs3:IntelligentTiering\(dq|\(dqs3:ObjectAcl:Put\(dq|\(dqs3:LifecycleExpiration:*\(dq|\(dqs3:LifecycleExpiration:Delete\(dq|\(dqs3:LifecycleExpiration:DeleteMarkerCreated\(dq|\(dqs3:ObjectTagging:*\(dq|\(dqs3:ObjectTagging:Put\(dq|\(dqs3:ObjectTagging:Delete\(dq, ...],
