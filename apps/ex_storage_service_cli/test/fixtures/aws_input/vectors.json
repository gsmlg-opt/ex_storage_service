          {
            "Key": "one",
            "VersionId": "v1"
          },
          {
            "Key": "two"
          }
        ],
        "Quiet": false
      }
    },
    {
      "operation": "PutBucketTagging",
      "member": "Tagging",
      "value": "TagSet=[{Key=first,Value=\"\"},{Key=second,Value=\"a,b\"}]",
      "expected": {
        "TagSet": [
          {
            "Key": "first",
            "Value": ""
          },
          {
            "Key": "second",
            "Value": "a,b"
          }
        ]
      }
    },
    {
      "operation": "PutBucketLifecycleConfiguration",
      "member": "LifecycleConfiguration",
      "value": "Rules=[{ID=r,Status=Enabled,Filter={Prefix=docs/},Expiration={Days=30}}]",
      "expected": {
        "Rules": [
          {
            "ID": "r",
            "Status": "Enabled",
            "Filter": {
              "Prefix": "docs/"
            },
            "Expiration": {
              "Days": 30
            }
          }
        ]
      }
    },
    {
      "operation": "PutBucketCors",
      "member": "CORSConfiguration",
      "value": "CORSRules=[{AllowedMethods=[GET,PUT],AllowedOrigins=[https://example.com],MaxAgeSeconds=300}]",
