        "CORSRules": [
          {
            "AllowedMethods": [
              "GET",
              "PUT"
            ],
            "AllowedOrigins": [
              "https://example.com"
            ],
            "MaxAgeSeconds": 300
          }
        ]
      }
    },
    {
      "operation": "RestoreObject",
      "member": "RestoreRequest",
      "value": "Days=5,GlacierJobParameters={Tier=Standard}",
      "expected": {
        "Days": 5,
        "GlacierJobParameters": {
          "Tier": "Standard"
        }
      }
    }
