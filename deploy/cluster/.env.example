# Copy to .env and replace every value before starting the cluster.
# ESS_INTERNAL_SECRET must contain at least 32 bytes in production.
ESS_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
ESS_MASTER_KEY=replace-with-a-high-entropy-master-key
RELEASE_COOKIE=replace-with-a-long-non-default-erlang-cookie

# Stable across every voter.
ESS_CLUSTER_NAME=ess-local

# Keep writers and maintenance closed through restore and registration.
# Enable repair/scrub first, complete the durability preflight, then enable
# the data plane and public S3.
ESS_CLUSTER_DATA_PLANE_ENABLED=false
ESS_PUBLIC_S3_ENABLED=false
ESS_REPAIR_ENABLED=false
ESS_SCRUB_ENABLED=false

# Use true only for the first start of three completely empty state volumes.
# Set false before every subsequent restart or upgrade.
ESS_CLUSTER_BOOTSTRAP=true
